{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://free-ai-school.example/schemas/ai-path-research-review-2026-07-17.v1.json",
  "title": "AI Path two-reviewer calibration packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewers", "ratings"],
  "properties": {
    "schemaVersion": { "const": "2026-07-17.v1" },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/opaqueId" }
    },
    "ratings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/rating" }
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+){0,7}$"
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participantId",
        "findingId",
        "skillId",
        "reviewerId",
        "evidenceVerdict",
        "proposedLevel",
        "confidence",
        "reasonCodes"
      ],
      "properties": {
        "participantId": { "$ref": "#/$defs/opaqueId" },
        "findingId": { "$ref": "#/$defs/opaqueId" },
        "reviewerId": { "$ref": "#/$defs/opaqueId" },
        "skillId": {
          "enum": [
            "foundations",
            "prompt-context",
            "workflow-design",
            "data-retrieval",
            "coding-apis",
            "agents-tools",
            "evaluation-reliability",
            "deployment-operations",
            "safety-governance"
          ]
        },
        "evidenceVerdict": {
          "enum": ["supported", "partially_supported", "materially_wrong", "not_assessable"]
        },
        "proposedLevel": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1, "maximum": 4 }
          ]
        },
        "confidence": { "enum": ["low", "medium", "high"] },
        "reasonCodes": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "missing_quote",
              "ownership_unclear",
              "artifact_unverified",
              "outcome_unmeasured",
              "contradiction_unresolved",
              "level_too_high",
              "level_too_low",
              "not_assessed_expected"
            ]
          }
        }
      }
    }
  }
}
